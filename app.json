{
  "expo": {
    "name": "GraceLink",
    "slug": "goappchurch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#120628",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reyuvel.goappchurch",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.reyuvel.goappchurch",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#120628"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "meta": {
        "themeColor": "#7B2FF7",
        "viewport": "width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover"
      },
      "manifest": {
        "name": "GraceLink",
        "short_name": "GraceLink",
        "description": "Travel and event management for GraceLink",
        "theme_color": "#1A0B3B",
        "background_color": "#1A0B3B",
        "display": "standalone",
        "orientation": "portrait",
        "start_url": "/",
        "scope": "/",
        "icons": [
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-av",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c78beff2-2a63-4654-9c95-8bafb00e58c4"
      }
    },
    "owner": "goappchurch"
  }
}
