    "expo-secure-store": "~13.0.2",
    "react": "^19.1.1",
    "react-native": "^0.80.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.0",
